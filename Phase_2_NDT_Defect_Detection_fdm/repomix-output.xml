        print(f"  IoU: {result['iou']:.3f}, K_error: {result['k_error']:.4f}, Time: {elapsed:.1f}s")
    
    # 统计
    print("\n" + "="*70)
    print("统计结果")
    print("="*70)
    
    for metric in ['iou', 'k_error', 'time']:
